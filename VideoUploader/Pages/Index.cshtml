@page
@model IndexModel
@{
    ViewData["Title"] = "Login";
}
<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="card">
            <div class="card-body text-center p-5">
                <i class="bi bi-cloud-upload-fill text-primary" style="font-size: 4rem;"></i>
                <h2 class="card-title mt-3 mb-2">Video Uploader</h2>
                <p class="text-muted mb-4">Upload and share your videos to Facebook and YouTube Shorts with AI-powered captions</p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-danger" role="alert">
                        @Model.ErrorMessage
                    </div>
                }

                <div class="d-grid gap-3">
                    <form method="post" asp-page-handler="FacebookLogin">
                        <button type="submit" class="btn btn-facebook btn-lg w-100">
                            <i class="bi bi-facebook me-2"></i> Login with Facebook
                        </button>
                    </form>

                    <form method="post" asp-page-handler="YouTubeLogin">
                        <button type="submit" class="btn btn-danger btn-lg w-100">
                            <i class="bi bi-youtube me-2"></i> Login with YouTube
                        </button>
                    </form>
                </div>

                <div class="mt-4 text-muted small">
                    <p class="mb-0">By logging in, you agree to allow this app to post videos on your behalf</p>
                </div>
            </div>
        </div>
    </div>
</div>